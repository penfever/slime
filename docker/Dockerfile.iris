ARG SLIME_BASE_IMAGE=slimerl/slime:latest
FROM ${SLIME_BASE_IMAGE}

ARG MARIN_IRIS_REVISION=922781dc5d32f28f3e47f37b17be8ac7269e013d

# Keep this pin aligned with requirements.txt. This small derivative lets Iris
# jobs consume launcher-managed S3 inputs and publish coding-agent adapter
# endpoints without rebuilding the CUDA stack. This Daytona image resolves the
# complete Iris runtime. Iris currently selects pyqwest 0.6.x, outside E2B's
# declared range, so use the base Slime image for E2B-backed rollouts.
RUN python -m pip install --no-cache-dir "s3fs==2026.4.0" && \
    python -m pip install --no-cache-dir \
        "marin-rigging @ https://github.com/marin-community/marin/archive/${MARIN_IRIS_REVISION}.zip#subdirectory=lib/rigging" \
        "marin-iris @ https://github.com/marin-community/marin/archive/${MARIN_IRIS_REVISION}.zip#subdirectory=lib/iris" && \
    python -c "from importlib.metadata import version; from iris.cluster.client.endpoint_client import EndpointClient; from iris.cluster.client.job_info import get_job_info; from iris.cluster.types import EndpointAccess; from iris.rpc.controller_connect import ControllerServiceClientSync, EndpointServiceClientSync; from rigging.timing import Duration; assert version('s3fs') == '2026.4.0'"
