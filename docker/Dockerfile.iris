ARG SLIME_BASE_IMAGE=slimerl/slime@sha256:39be6cbb00f9b6770e664ace0c7b9f5ecff2977a1a205e7926a720f906fbc62c
FROM ${SLIME_BASE_IMAGE}

# This is the exact runtime overlay installed by the healthy r13 Slime arm.
# Pin the mutually released Marin packages together so a later package upload
# cannot make pip combine Iris with a different rigging/finestore build.
RUN python -m pip install --no-cache-dir \
        "s3fs==2026.7.0" \
        "daytona==0.207.1" \
        "marin-iris==0.2.91.dev32816546334" \
        "marin-rigging==0.2.91.dev32816546334" \
        "marin-finestore==0.2.91.dev32816546334" && \
    python -c "from importlib.metadata import version; import daytona; from iris.cluster.client.endpoint_client import EndpointClient; from iris.cluster.client.job_info import get_job_info; from iris.cluster.types import EndpointAccess; from iris.rpc.controller_connect import ControllerServiceClientSync, EndpointServiceClientSync; from rigging.timing import Duration; assert version('daytona') == '0.207.1'; assert version('marin-iris') == '0.2.91.dev32816546334'; assert version('marin-rigging') == '0.2.91.dev32816546334'; assert version('marin-finestore') == '0.2.91.dev32816546334'; assert version('s3fs') == '2026.7.0'"
